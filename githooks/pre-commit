#!/bin/sh
# Installé par `just hooks`. Ce qui casse la CI doit casser ici d'abord :
# un aller-retour de trente secondes en local vaut mieux qu'un rouge dans
# une pull request cinq minutes plus tard.
set -e

gofmt -l . | grep . && { echo "gofmt: fichiers non formatés ci-dessus"; exit 1; }
go vet ./...
go test ./...
